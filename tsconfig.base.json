{
  // Shared compiler options. Deliberately has NO `paths` mapping: package
  // builds must resolve sibling packages through node_modules (i.e. their built
  // dist output), which pnpm orders topologically. Only the root typecheck
  // config adds `paths` so it can check everything from source without a build.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
