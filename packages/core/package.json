{
  "name": "@aee/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EvidenceService: the single application service used by both HTTP and MCP.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aee/schemas": "workspace:*",
    "@aee/fetcher": "workspace:*",
    "@aee/extraction": "workspace:*",
    "@aee/cache": "workspace:*"
  }
}
