# =============================================================================
# Agent Evidence API — PRODUCTION environment template
#
#   >>> THIS FILE IS MAINNET. <<<
#   Base MAINNET (eip155:8453) + real USDC. Money moves here.
#
# Copy to docker/.env before deploying and fill in the blanks:
#     cp docker/env.production.example docker/.env
#
# For local development / testnet use docker/env.development.example instead.
# Never point this file at a testnet wallet, and never point the development
# file at a mainnet wallet: testnet and production payment configuration must
# never be mixed (AGENTS.md section 6).
#
# PLACEHOLDERS ONLY. Do not commit real values. docker/.env is gitignored.
# =============================================================================

# --- Service identity -------------------------------------------------------
NODE_ENV=production
SERVICE_NAME=agent-evidence-api
SERVICE_VERSION=0.1.0

# --- Backend (VPS container) HTTP server ------------------------------------
# 0.0.0.0 is correct INSIDE the container (a published port reaches the
# container IP, not its loopback). What is exposed to the network is decided by
# the compose port binding, which is 127.0.0.1 only. For a bare-metal run
# without Docker, set this back to 127.0.0.1.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# Public origin of the backend as reachable by the Worker (Cloudflare Tunnel or
# reverse proxy). Placeholder only — do not invent a real domain (SPEC §33).
BACKEND_ORIGIN_URL=https://origin.example.invalid

# --- Worker-to-backend authentication --------------------------------------
# Shared secret for server-to-server calls by the Cloudflare Worker.
# REQUIRED: the backend refuses to start without a strong value.
# Generate one with:   openssl rand -hex 32
# The SAME value must be set for the Worker:
#   npx wrangler secret put BACKEND_AUTH_SECRET
# Never expose this to customers or commit it.
BACKEND_AUTH_SECRET=

# --- x402 payment — PRODUCTION / BASE MAINNET -------------------------------
# eip155:8453  = Base MAINNET  <-- this file (real funds)
# eip155:84532 = Base Sepolia  <-- docker/env.development.example (test funds)
X402_NETWORK=eip155:8453

# PUBLIC receiving address only. Receiving USDC needs no private key, ever.
# Paste your own mainnet address. Never commit a private key or seed phrase.
X402_RECIPIENT=

X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USD=0.03

# --- Test-only wallet — MUST STAY EMPTY IN PRODUCTION -----------------------
# This key is Base Sepolia only. Setting it in a mainnet deployment risks
# testnet automation touching production configuration. Leave blank.
X402_TEST_PRIVATE_KEY=

# --- Resource limits (all bounded by design) -------------------------------
MAX_CONCURRENT_FETCHES=4
MAX_URLS_PER_REQUEST=5
MAX_RESPONSE_BYTES=2097152
MAX_REDIRECTS=5
REQUEST_TIMEOUT_MS=10000
CONNECT_TIMEOUT_MS=5000
MAX_EVIDENCE_ITEMS=5
MAX_EXCERPT_CHARS=600

# --- Cache -----------------------------------------------------------------
CACHE_ENABLED=true
# Container path: the named volume `aee-cache` is mounted at /app/data, so the
# SQLite cache survives container rebuilds. For a bare-metal run use
# CACHE_DB_PATH=./data/cache.sqlite
CACHE_DB_PATH=/app/data/cache.sqlite
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=5000

# --- Fetching behaviour ----------------------------------------------------
# Clearly identifiable User-Agent, per SPEC section 19. Replace the placeholder
# contact URL with a real one you control before going live.
FETCH_USER_AGENT=AgentEvidenceAPI/0.1.0 (+https://example.invalid/bot)
ROBOTS_POLICY=warn

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info

# --- Optional providers (interfaces exist; none required for v0.1) ---------
# Never hard-code a vendor as the production intelligence provider (SPEC §9).
# SEARCH_PROVIDER=
# SEARCH_API_KEY=
# REASONING_PROVIDER=
# REASONING_BASE_URL=
# REASONING_API_KEY=
# REASONING_MODEL=

# --- Domain placeholders (do not invent real domains) ----------------------
PUBLIC_API_DOMAIN=api.example.invalid
# The public MCP endpoint the Worker exposes. This value is what belongs in
# server.json's `remotes[].url` when publishing to the MCP Registry.
MCP_PUBLIC_URL=https://mcp.example.invalid/mcp
