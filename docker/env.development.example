# =============================================================================
# Agent Evidence API — DEVELOPMENT / TESTNET environment template
#
#   >>> THIS FILE IS TESTNET ONLY. <<<
#   Base SEPOLIA (eip155:84532) + test USDC. No real money moves here.
#
# Copy to .env for local development:
#     cp docker/env.development.example .env
#
# Production / mainnet values live in docker/env.production.example.
# Testnet and production payment configuration must NEVER be mixed: a testnet
# private key must never be used with mainnet funds, and this file must never
# carry a mainnet receiving address (AGENTS.md section 6).
#
# PLACEHOLDERS ONLY. Do not commit real values. `.env` is gitignored.
# =============================================================================

# --- Service identity -------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=agent-evidence-api
SERVICE_VERSION=0.1.0

# --- Backend (VPS) HTTP server ---------------------------------------------
# Local development talks to the backend directly on loopback.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
# Public origin of the backend as reachable by the Worker. When running the
# Worker locally (`pnpm dev:worker`) this is the local backend.
# Placeholder only — do not invent a real domain (SPEC §33).
BACKEND_ORIGIN_URL=http://127.0.0.1:8080

# --- Worker-to-backend authentication --------------------------------------
# Shared secret for server-to-server calls. REQUIRED: the backend refuses to
# start without a strong value (16+ characters).
# Generate one with:   openssl rand -hex 32
# The SAME value goes into apps/worker/.dev.vars for local Worker development.
# Never expose this to customers or commit it.
BACKEND_AUTH_SECRET=

# --- x402 payment — DEVELOPMENT / BASE SEPOLIA ------------------------------
# eip155:84532 = Base SEPOLIA  <-- this file (test funds)
# eip155:8453  = Base MAINNET  <-- docker/env.production.example (real funds)
X402_NETWORK=eip155:84532

# PUBLIC receiving address only: a disposable TESTNET wallet address.
# Never put a mainnet address here.
X402_RECIPIENT=

X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USD=0.03

# --- Test-only wallet (Base Sepolia) ---------------------------------------
# Disposable testnet wallet used by automated payment tests.
# Never fund with mainnet assets. Never commit. Leave blank if unavailable.
X402_TEST_PRIVATE_KEY=

# --- Resource limits (all bounded by design) -------------------------------
MAX_CONCURRENT_FETCHES=4
MAX_URLS_PER_REQUEST=5
MAX_RESPONSE_BYTES=2097152
MAX_REDIRECTS=5
REQUEST_TIMEOUT_MS=10000
CONNECT_TIMEOUT_MS=5000
MAX_EVIDENCE_ITEMS=5
MAX_EXCERPT_CHARS=600

# --- Cache -----------------------------------------------------------------
CACHE_ENABLED=true
# Local, relative to the repository root. The `data/` directory is gitignored.
CACHE_DB_PATH=./data/cache.sqlite
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=5000

# --- Fetching behaviour ----------------------------------------------------
# Clearly identifiable User-Agent, per SPEC section 19.
FETCH_USER_AGENT=AgentEvidenceAPI/0.1.0 (+https://example.invalid/bot)
ROBOTS_POLICY=warn

# --- Observability ---------------------------------------------------------
# `debug` is fine for local development only; production uses `info`.
LOG_LEVEL=debug

# --- Optional providers (interfaces exist; none required for v0.1) ---------
# Never hard-code a vendor as the production intelligence provider (SPEC §9).
# SEARCH_PROVIDER=
# SEARCH_API_KEY=
# REASONING_PROVIDER=
# REASONING_BASE_URL=
# REASONING_API_KEY=
# REASONING_MODEL=

# --- Domain placeholders (do not invent real domains) ----------------------
PUBLIC_API_DOMAIN=api.example.invalid
MCP_PUBLIC_URL=https://mcp.example.invalid/mcp
