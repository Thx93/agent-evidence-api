# ---------------------------------------------------------------------------
# Agent Evidence API — environment template
#
# Copy to `.env` for local development. NEVER commit `.env`.
# This file contains PLACEHOLDERS ONLY. Do not put real secrets here.
# ---------------------------------------------------------------------------

# --- Service identity -------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=agent-evidence-api
SERVICE_VERSION=0.1.1

# --- Backend (VPS) HTTP server ---------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
# Public origin of the backend as reachable by the Worker.
# Placeholder only — do not invent a real domain.
BACKEND_ORIGIN_URL=https://backend.example.invalid

# --- Worker-to-backend authentication --------------------------------------
# Shared secret for server-to-server calls. Generate with: openssl rand -hex 32
# The backend refuses to start without it. Never expose this to customers.
BACKEND_AUTH_SECRET=

# --- x402 payment ----------------------------------------------------------
# Base Sepolia (test)  = eip155:84532
# Base mainnet (prod)  = eip155:8453
X402_NETWORK=eip155:84532

# PUBLIC receiving address only. No private key is ever needed to receive.
# Testnet and production wallet configuration must never be mixed.
X402_RECIPIENT=

X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USD=0.03

# --- Test-only wallet (Base Sepolia) ---------------------------------------
# Disposable testnet wallet used by automated payment tests.
# Never fund with mainnet assets. Never commit. Leave blank if unavailable.
X402_TEST_PRIVATE_KEY=

# --- Resource limits (all bounded by design) -------------------------------
MAX_CONCURRENT_FETCHES=4
MAX_URLS_PER_REQUEST=5
MAX_RESPONSE_BYTES=2097152
MAX_REDIRECTS=5
REQUEST_TIMEOUT_MS=10000
CONNECT_TIMEOUT_MS=5000
MAX_EVIDENCE_ITEMS=5
MAX_EXCERPT_CHARS=600

# --- Request rate limiting (per client, SPEC section 23) -------------------
# Sustained requests allowed per minute, per client key. 0 disables limiting.
# Key resolution: CF-Connecting-IP -> first X-Forwarded-For entry -> socket IP.
# The Worker must forward CF-Connecting-IP for per-client limiting to be
# meaningful; otherwise all callers share the Worker's bucket.
RATE_LIMIT_PER_MINUTE=60
# Extra headroom above the sustained rate that one client may consume at once.
RATE_LIMIT_BURST=20

# --- Cache -----------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DB_PATH=./data/cache.sqlite
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=5000

# Append-only record of served requests. Because the Worker gates the endpoint
# with x402, every line here is a SETTLED PAYMENT - this is the revenue record.
# Set to "off" to disable. Lives on the same volume as the cache so it survives
# container recreation.
USAGE_LOG_PATH=./data/usage.jsonl

# --- Fetching behaviour ----------------------------------------------------
# Clearly identifiable User-Agent, per SPEC section 19.
FETCH_USER_AGENT=AgentEvidenceAPI/0.1.0 (+https://example.invalid/bot)
ROBOTS_POLICY=warn

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info

# --- Optional providers (interfaces exist; none required for v0.1) ---------
# SEARCH_PROVIDER=
# SEARCH_API_KEY=
# REASONING_PROVIDER=
# REASONING_BASE_URL=
# REASONING_API_KEY=
# REASONING_MODEL=

# --- Domain placeholders (do not invent real domains) ----------------------
PUBLIC_API_DOMAIN=api.example.invalid
MCP_PUBLIC_URL=https://mcp.example.invalid/mcp
