{
  "name": "@aee/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker edge: public proxy in front of the backend's x402 paywall, MCP endpoint, backend forwarding.",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist --env=\"\"",
