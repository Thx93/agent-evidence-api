    "dev:test": "wrangler dev --env test",
    "deploy": "wrangler deploy --env=\"\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aee/schemas": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "wrangler": "^4.135.0"
  }
}
