{
  // NOTE: the `alias` block that stubbed @x402/svm is gone. It existed only
  // because the CDP SDK was imported here for the payment gate, and this Worker
  // no longer imports any x402 package: the paywall runs in the backend, where
  // the CDP Facilitator can actually operate. If an x402 import is ever added
  // back, expect six unresolved @x402/svm/* imports and re-read
  // docs/market-analysis.md before treating that as a bundler problem.

  // Cloudflare Worker — the public edge.
  // Responsibilities (SPEC section 13): request shape validation, forwarding
  // authorised requests to the backend, MCP endpoint, health/capabilities.
  // Payment enforcement is NOT here; see the header comment in src/index.ts.
  // No heavy extraction or reasoning happens here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-evidence-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ---------------------------------------------------------------------------
  // PRODUCTION (a bare `wrangler deploy` ships this block).
  //
  // BACKEND_AUTH_SECRET is deliberately ABSENT: it is a secret and must come
  // from `wrangler secret put BACKEND_AUTH_SECRET`. Putting it here would commit
  // it to the repository.
  //
  // The payment vars below are DISPLAY-ONLY. They are read by the landing page,
  // the `GET /` capability document and `/.well-known/x402`; the paywall that
  // actually charges runs in the backend and reads its own environment. They must
  // be kept in step with the backend by hand — the live 402 challenge is the
  // authority, and `scripts/check-readiness.sh` compares the two, because a
  // manifest that advertises a price the service does not charge is worse than no
  // manifest.
  //
  // NOTE: wrangler does NOT inherit top-level `vars` into a named environment.
  // Every var the Worker reads is repeated in each env block below; omitting one
  // yields `undefined` with only a warning, not an error.
  // ---------------------------------------------------------------------------
  "vars": {
    // Base mainnet. eip155:84532 = Base Sepolia (test).
    "X402_NETWORK": "eip155:8453",

    // PUBLIC receiving address only — no private key is ever needed to receive.
    // This is the production wallet; the backend holds the same value and is what
    // actually receives.
    "X402_RECIPIENT": "0x9c0e2B44180439294Fa30Ae2B2a94f8655455FD0",

    "X402_FACILITATOR_URL": "https://facilitator.payai.network",
    "X402_PRICE_USD": "0.003",

    // Placeholder origin — RFC 2606 reserves .invalid so a missed replacement
    // fails loudly instead of pointing at a real third-party host.
    "BACKEND_ORIGIN_URL": "https://origin.example.invalid"
  },

  "env": {
    // Local development. Activated with `wrangler dev --env dev`.
    //
    // The payment bypass is NO LONGER a Worker variable: the paywall runs in the
    // backend, so the bypass is the backend's `DEV_BYPASS_PAYMENT=true` (which
    // also requires a non-mainnet X402_NETWORK). Setting it here does nothing.
    //
    // X402_RECIPIENT is display-only here (see the note above). Never point any of
    // it at a wallet holding real value when X402_NETWORK is a testnet.
    "dev": {
      "vars": {
        "X402_NETWORK": "eip155:84532",
        "X402_RECIPIENT": "0x9c0e2B44180439294Fa30Ae2B2a94f8655455FD0",
        "X402_FACILITATOR_URL": "https://facilitator.payai.network",
        "X402_PRICE_USD": "0.003",
        "BACKEND_ORIGIN_URL": "http://127.0.0.1:8080"
      }
    },

    // Testnet integration: payment IS required, backend is local. This is the
    // environment the automated x402 tests target.
    "test": {
      "vars": {
        "X402_NETWORK": "eip155:84532",
        "X402_RECIPIENT": "0x9c0e2B44180439294Fa30Ae2B2a94f8655455FD0",
        "X402_FACILITATOR_URL": "https://facilitator.payai.network",
        "X402_PRICE_USD": "0.003",
        "BACKEND_ORIGIN_URL": "http://127.0.0.1:8080"
      }
    }
  }
}
